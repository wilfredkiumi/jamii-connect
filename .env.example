# ===================================
# Jamii Connect - Environment Variables
# ===================================
# Copy this file to .env.local and fill in your AWS credentials
# Get these values after deploying the AWS CDK infrastructure


# ===================================
# AWS Cognito Configuration
# ===================================
# User Pool ID - Format: us-east-1_xxxxxxxxx
NEXT_PUBLIC_USER_POOL_ID=us-east-1_xxxxx

# User Pool Client ID - Long alphanumeric string
NEXT_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx

# Identity Pool ID - Format: us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# AWS Region - Default: us-east-1
NEXT_PUBLIC_AWS_REGION=us-east-1


# ===================================
# AWS API Gateway
# ===================================
# API Endpoint URL - Format: https://xxxxx.execute-api.{region}.amazonaws.com/prod
NEXT_PUBLIC_API_ENDPOINT=https://xxxxx.execute-api.us-east-1.amazonaws.com/prod


# ===================================
# DynamoDB Table Names (Optional)
# ===================================
# If using custom table names, uncomment and set these
# Default format: JamiiConnect-{TableName}-{Environment}

# DYNAMODB_USERS_TABLE=JamiiConnect-Users-prod
# DYNAMODB_POSTS_TABLE=JamiiConnect-Posts-prod
# DYNAMODB_JOBS_TABLE=JamiiConnect-Jobs-prod
# DYNAMODB_EVENTS_TABLE=JamiiConnect-Events-prod
# DYNAMODB_SERVICES_TABLE=JamiiConnect-Services-prod
# DYNAMODB_CONNECTIONS_TABLE=JamiiConnect-Connections-prod


# ===================================
# Application Configuration
# ===================================
# Base URL for your application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment: development | staging | production
NODE_ENV=development


# ===================================
# AWS SDK Credentials (Optional)
# ===================================
# Only needed for local development with AWS SDK
# NOT required if using Cognito authentication from frontend

# AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ===================================
# S3 & CloudFront (Auto-configured)
# ===================================
# These are automatically configured through Cognito Identity Pool
# No manual configuration needed for file uploads


# ===================================
# Deployment Notes
# ===================================
# 1. Deploy AWS infrastructure first:
#    cd infrastructure && npm install && cdk deploy
#
# 2. Copy the CloudFormation outputs to this file
#
# 3. Restart your Next.js dev server after updating .env.local
#
# For detailed setup instructions, see README.md
